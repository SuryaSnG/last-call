FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /build

COPY pom.xml ./pom.xml
COPY shared-dtos ./shared-dtos
COPY item-service ./item-service

RUN sed -i '/<modules>/,/<\/modules>/d' pom.xml && \
    mvn install:install-file -Dfile=pom.xml -DpomFile=pom.xml && \
    mvn clean install -DskipTests -f shared-dtos/pom.xml && \
    mvn clean package -DskipTests -f item-service/pom.xml

FROM eclipse-temurin:17-jdk-jammy

WORKDIR /app

COPY --from=build /build/item-service/target/item-service-*.jar app.jar

EXPOSE 8082

ENTRYPOINT ["java", "-jar", "app.jar"]
